# Server Configuration
PORT=4000
NODE_ENV=development

# Security Secrets (Must be at least 32 characters in production)
JWT_SECRET=placeholder_jwt_secret_change_me_to_a_random_32_char_key

# Database Connection URL
# Local development (SQLite):
DATABASE_URL="file:./dev.db"

# Target Production Deployment (PostgreSQL):
# DATABASE_URL="postgresql://kit_admin:secure_password@prod-db.internal:5432/event_kit_prod?schema=public"

# Frontend Origin for CORS
CORS_ORIGIN="http://localhost:5173"
